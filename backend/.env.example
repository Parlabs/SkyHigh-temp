# SkyHigh Discord Sync — Environment Variables
# Copy this to .env and fill in your real values. Never commit .env to git.

# From Discord Developer Portal → Your App → OAuth2
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret

# From Discord Developer Portal → Your App → Bot
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord server ID (right-click server → Copy Server ID with developer mode on)
DISCORD_GUILD_ID=your_discord_server_id

# The role ID you want SkyHigh members to receive
# Right-click the role in Server Settings → Copy Role ID
DISCORD_MEMBER_ROLE_ID=the_member_role_id

# Must match exactly what you put in the Discord OAuth2 Redirects list
# Should point to your Node server's /discord/callback route
DISCORD_REDIRECT_URI=https://YOUR_SERVER_OR_DOMAIN/discord/callback

# Any long random string — used to sign and verify OAuth state
STATE_SECRET=replace_this_with_a_long_random_string_at_least_32_chars

# Port for the Node server
PORT=3001
