rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // joinApplications — main user collection used across SkyHigh
    match /joinApplications/{userId} {

      // Users can read their own doc
      allow read: if request.auth != null && request.auth.uid == userId;

      // Public aggregate read (for member count on homepage)
      // Remove this if you don't need the public counter
      allow read: if true;

      // Users can create their own doc (signup)
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can update their own doc BUT cannot touch privileged fields
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !('hqStaff'          in request.resource.data.diff(resource.data).changedKeys())
        && !('discordRoleSynced' in request.resource.data.diff(resource.data).changedKeys())
        && !('atcRating'         in request.resource.data.diff(resource.data).changedKeys())
        && !('pilotRating'       in request.resource.data.diff(resource.data).changedKeys())
        && !('awards'            in request.resource.data.diff(resource.data).changedKeys());

      allow delete: if false;
    }

    // Events collection — public read, staff write only
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
